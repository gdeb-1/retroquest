{% extends 'base.html.twig' %}

{% block title %}Proposer un échange - Retroquest{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-4 fw-bold text-dark text-center text-md-start">Proposer un Échange</h1>

                    {% if not form.vars.valid %}
                        <div class="alert alert-danger mb-4 rounded-3">
                            {{ form_errors(form) }}
                        </div>
                    {% endif %}

                    <div class="row g-4 mb-4">
                        <!-- Target Game (Receiver Item) -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h2 class="h6 text-muted fw-bold text-uppercase mb-3">Jeu souhaité</h2>
                                <h3 class="h5 fw-bold text-dark mb-1">{{ receiverItem.game.title }}</h3>
                                <p class="text-secondary small mb-3">{{ receiverItem.game.console }} ({{ receiverItem.game.releaseYear }})</p>
                                
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <span class="badge bg-primary">{{ receiverItem.state.value }}</span>
                                    <span class="badge bg-secondary">
                                        {{ receiverItem.currency.value == 'EUR' ? '€' : receiverItem.currency.value == 'USD' ? '$' : '£' }}{{ (receiverItem.acquisitionPrice / 100)|number_format(2) }}
                                    </span>
                                </div>
                                <div class="text-muted small">
                                    <i class="bi bi-person-fill me-1"></i> Propriétaire : <strong>{{ receiverItem.collector.email }}</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Proposer Selection Info -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <h2 class="h6 text-muted fw-bold text-uppercase mb-3">Votre contrepartie</h2>
                                    <p class="text-secondary small">Sélectionnez les jeux de votre collection que vous souhaitez offrir en échange.</p>
                                </div>
                                {% if not hasAvailableItems %}
                                    <div class="alert alert-warning border-0 rounded-3 mb-0 small">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        Vous n'avez aucun jeu disponible dans votre collection pour proposer cet échange.
                                        <a href="{{ path('app_collector_add_collection_item') }}" class="alert-link d-block mt-2">Ajouter un jeu à ma collection</a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {% if hasAvailableItems %}
                        {{ form_start(form) }}
                            <div class="mb-4">
                                {{ form_label(form.offeredItems) }}
                                <div class="card bg-white border border-light-subtle rounded-3 p-3 overflow-auto" style="max-height: 250px;">
                                    {% for child in form.offeredItems %}
                                        <div class="form-check py-2 border-bottom border-light-subtle last-border-none">
                                            {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(child, null, {'label_attr': {'class': 'form-check-label fw-semibold text-dark small'}}) }}
                                        </div>
                                    {% endfor %}
                                </div>
                                {{ form_help(form.offeredItems) }}
                                {{ form_errors(form.offeredItems) }}
                            </div>

                            <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                                <a href="{{ path('app_collector_exchange_search') }}" class="btn btn-outline-secondary py-2 px-4 rounded-3 order-2 order-sm-1">
                                    Annuler
                                </a>
                                <button type="submit" class="btn btn-primary py-2 px-4 rounded-3 order-1 order-sm-2 ms-sm-auto">
                                    Envoyer la proposition d'échange
                                </button>
                            </div>
                        {{ form_end(form) }}
                    {% else %}
                        <div class="d-flex gap-2 mt-4">
                            <a href="{{ path('app_collector_exchange_search') }}" class="btn btn-outline-secondary py-2 px-4 rounded-3 w-100">
                                Retour aux jeux disponibles
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .last-border-none:last-child {
        border-bottom: 0 !important;
    }
</style>
{% endblock %}
