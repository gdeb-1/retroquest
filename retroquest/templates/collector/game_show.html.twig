{% extends 'base.html.twig' %}

{% block title %}{{ game.title }} - Fiche du Jeu - Retroquest{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="mb-4">
        <a href="{{ path('app_collector_guild_catalog') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour au catalogue
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-white p-4">
        <div class="mb-4">
            <h1 class="display-6 fw-bold text-dark mb-1">{{ game.title }}</h1>
            <span class="badge bg-primary fs-6">{{ game.console }}</span>
            <span class="badge bg-secondary fs-6 ms-2">Sortie : {{ game.releaseYear }}</span>
        </div>

        <hr class="text-muted opacity-25">
        <div class="mt-3">
            {{ dump({
                'id': game.id,
                'title': game.title,
                'console': game.console,
                'releaseYear': game.releaseYear,
                'isHidden': game.isHidden
            }) }}
        </div>
    </div>
</div>
{% endblock %}
