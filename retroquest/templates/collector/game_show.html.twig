{% extends 'base.html.twig' %}

{% block title %}{{ game.title }} - Fiche du Jeu - Retroquest{% endblock %}

{% block body %}
<div class="container py-4">
    <div {{ vue_component('pages/GameShow', {
        game: {
            id: game.id,
            title: game.title,
            console: game.console,
            releaseYear: game.releaseYear
        },
        description: description,
        collectionCount: collectionCount,
        averagePrices: averagePrices,
        reviews: reviews
    }) }}></div>

    {% if not hasReviewed %}
        <div class="mt-4">
            <div class="card border border-light-subtle rounded-4 shadow-sm bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i>
                    <span>Rédiger un avis</span>
                </h5>
                
                <p class="text-secondary small mb-4">
                    Partagez votre expérience de jeu avec la guilde. Votre avis sera publié une fois validé par l'équipe de modération.
                </p>

                {% if not form.vars.valid %}
                    <div class="alert alert-danger border-0 rounded-3 d-flex align-items-center gap-2 py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            {% for error in form.comment.vars.errors %}
                                <div>{{ error.message }}</div>
                            {% endfor %}
                            {% for error in form.vars.errors %}
                                <div>{{ error.message }}</div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {{ form_start(form) }}
                    <div class="form-group mb-3">
                        {{ form_row(form.comment, {
                            'label': false,
                            'attr': {
                                'class': 'form-control rounded-3 border-light-subtle p-3 text-secondary review-textarea',
                                'rows': 4,
                                'placeholder': 'Écrivez votre avis ici (au moins 5 caractères)...'
                            }
                        }) }}
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-3 px-4 py-2 fw-semibold shadow-sm hover-lift">
                            <i class="bi bi-send-fill"></i>
                            <span>Soumettre l'avis</span>
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    {% elseif hasReviewed and not userReview.isValid %}
        <div class="mt-4">
            <div class="card border border-light-subtle rounded-4 shadow-sm bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary"></i>
                    <span>Votre avis</span>
                </h5>
                <p class="text-secondary small mb-4">
                    Vous avez déjà laissé un avis sur ce jeu. Il est en attente de modération.
                </p>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
