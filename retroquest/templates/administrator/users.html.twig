{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Retroquest{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Gestion des utilisateurs</h1>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Rôles</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.email }}</td>
                            <td>
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="badge bg-danger">Admin</span>
                                    {% elseif role == 'ROLE_MODERATOR' %}
                                        <span class="badge bg-warning text-dark">Modérateur</span>
                                    {% elseif role == 'ROLE_COLLECTOR' %}
                                        <span class="badge bg-info text-dark">Collectionneur</span>
                                    {% elseif role == 'ROLE_USER' %}
                                        <span class="badge bg-secondary">Utilisateur</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ role }}</span>
                                    {% endif %}
                                {% endfor %}
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
