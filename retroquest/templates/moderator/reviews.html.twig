{% extends 'base.html.twig' %}

{% block title %}Gestion des avis - Modérateur{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold mb-0">Modération des avis</h1>
    </div>

    {% set reviewsData = [] %}
    {% for review in reviews %}
        {% set reviewsData = reviewsData|merge([{
            id: review.id,
            comment: review.comment,
            isValid: review.isValid,
            createdAt: review.createdAt|date('d/m/Y H:i'),
            authorEmail: review.author.email,
            gameTitle: review.game.title,
            gameConsole: review.game.console,
            csrfTokenValidate: csrf_token('validate_review_' ~ review.id),
            csrfTokenDelete: csrf_token('delete_review_' ~ review.id)
        }]) %}
    {% endfor %}

    <div {{ vue_component('ModeratorReviews', {
        reviews: reviewsData
    }) }}></div>
</div>
{% endblock %}
