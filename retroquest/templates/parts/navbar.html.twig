<nav class="navbar navbar-expand navbar-light bg-white border-bottom py-3 mb-4 shadow-sm">
    <div class="container">
        <a href="{{ path('app_home') }}" class="navbar-brand d-flex align-items-center fw-bold text-dark fs-4 gap-2">
            <span class="logo-icon">🎮</span> Retroquest
        </a>
        {% if app.user is not null %}
            <div {{ vue_component('components/NavbarMenu', {
                isCollector: is_granted('ROLE_COLLECTOR'),
