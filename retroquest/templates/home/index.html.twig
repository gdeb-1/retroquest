{% extends 'base.html.twig' %}

{% block title %}Hello Vue!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font-family: sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Welcome to Retroquest!</h1>

    <p>This page is rendered by a Symfony Controller.</p>
    
    <h2>Vue Component (Hello.vue)</h2>
    <div {{ vue_component('Hello', { name: 'Symfony UX Vue' }) }} style="border: 2px dashed #ccc; padding: 20px; border-radius: 8px; margin-top: 10px;">
    </div>
</div>
{% endblock %}
