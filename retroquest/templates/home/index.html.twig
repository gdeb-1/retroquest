{% extends 'base.html.twig' %}

{% block title %}Price Guide - Retroquest{% endblock %}

{% block body %}
<div class="container">
    <div class="header">
        <h1>Retroquest</h1>
        <p>Price Guide des jeux populaires du moment</p>
    </div>

    {% if popularGames is not empty %}
        <div class="grid-layout">
            {% for game in popularGames %}
                <div {{ vue_component('GameCard', {
                    title: game.title,
                    console: game.console,
                    releaseYear: game.releaseYear,
                    additionsCount: game.additionsCount,
                    averagePrices: game.averagePrices
                }) }}></div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <p>Aucun jeu populaire n'a été ajouté aux collections au cours des 30 derniers jours.</p>
        </div>
    {% endif %}
</div>
{% endblock %}

